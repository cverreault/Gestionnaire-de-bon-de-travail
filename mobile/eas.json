{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "EAS_BUILD_PROFILE": "development" },
      "ios": { "simulator": true },
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": { "EAS_BUILD_PROFILE": "preview" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": { "EAS_BUILD_PROFILE": "production" }
    }
  },
  "submit": {
    "production": {
      "ios": { "appleTeamId": "SET_ME" },
      "android": { "track": "internal" }
    }
  }
}
